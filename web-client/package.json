{
  "name": "chisflash-web-client",
  "private": false,
  "version": "2.0.0",
  "description": "ChisFlash Burner - A web-based flash cartridge programming tool",
  "author": {
    "name": "tautcony",
    "email": "i@tautcony.xyz"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tautcony/beggar_socket.git"
  },
  "type": "module",
  "homepage": "./",
  "scripts": {
    "dev": "vite --force",
    "build": "vue-tsc && vite build --mode production",
    "build:dev": "vue-tsc && vite build --mode development",
    "preview": "vite preview",
    "lint": "eslint src/ tests/",
    "lint:fix": "eslint src/ tests/ --fix",
    "check:deps": "node scripts/check-architecture-deps.cjs",
    "type-check": "vue-tsc --noEmit",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest --coverage",
    "test:performance": "npx tsx tests/performance/CRC16Performance.ts",
    "test:gba-rom": "node scripts/run-gba-rom.mjs",
    "audit": "npm audit --registry=https://registry.npmjs.org",
    "audit:fix": "npm audit fix --registry=https://registry.npmjs.org",
    "bundle:analyze": "analyze",
    "build:analyze": "./analyze-build.sh",
    "build:clean": "rm -rf dist src-tauri/target",
    "tauri:dev": "node scripts/run-tauri.mjs dev",
    "tauri:build": "node scripts/run-tauri.mjs build",
    "rom-builder": "npx tsx src/services/lk/cli.ts"
  },
  "dependencies": {
    "@iconify-json/pixelarticons": "^1.2.10",
    "@iconify/vue": "^5.0.5",
    "@jimp/plugin-resize": "1.6.1",
    "@sentry/vue": "^11.14.0",
    "@tauri-apps/api": "^2.12.5",
    "buffer": "^6.0.3",
    "dompurify": "^3.4.18",
    "gbats": "^1.0.9",
    "image-q": "^4.0.0",
    "jimp": "1.6.0",
    "luxon": "^3.7.2",
    "marked": "^18.2.1",
    "pinia": "^4.1.0",
    "vue": "^3.5.45",
    "vue-i18n": "^11.4.22",
    "vue-router": "^5.5.1"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "@tauri-apps/cli": "^2.12.5",
    "@types/luxon": "^3.7.6",
    "@types/node": "^26.6.6",
    "@types/w3c-web-serial": "^1.0.9",
    "@types/w3c-web-usb": "^1.0.14",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vitest/coverage-v8": "^5.1.0",
    "@vitest/ui": "^5.1.0",
    "@vue/test-utils": "^2.6.0",
    "commander": "^15.1.0",
    "eslint": "^10.15.0",
    "eslint-import-resolver-node": "^0.4.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.18.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-vue": "^10.12.1",
    "eslint-plugin-vue-scoped-css": "^3.1.4",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "postcss-scss": "^4.0.9",
    "sass": "^1.108.2",
    "terser": "^5.51.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vite-bundle-analyzer": "^1.3.9",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "unrs-resolver@1.11.1": true
  }
}
